# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOT: Kaynak Excel'ler (public/data_admin/), dışa aktarılan figürler
# (exported_charts/, exported_svgs/) ve yardımcı scriptler bilinçli olarak
# repoya dahil edilir — makine değiştirirken kaybolmamaları için izlenirler.
